{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(GIT_EDITOR=true git rebase *)",
      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git branch -D *)",
      "Bash(git branch -m *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git merge-base *)",
      "Bash(git mv *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git worktree add *)",
      "Bash(git worktree prune)",
      "Bash(git worktree remove *)",
      "Bash(node scripts/build-dogfood-assets.mjs)",
      "Bash(node scripts/generate-llms-full.mjs)",
      "Bash(node scripts/generate-sitemap.mjs)",
      "Bash(npm ci)",
      "Bash(npm run check)",
      "Bash(npm test)",
      "Bash(npx vitest run *)",
      "Bash(python3 scripts/adr_ratify.py:*)",
      "mcp__linear__get_issue"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bundle-size-reminder.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/css-comment-guard.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/adr-status-guard.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/doc-freshness-guard.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "nonoun-plugins": {
      "source": {
        "source": "github",
        "repo": "kimgranlund/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "llm@nonoun-plugins": true,
    "harness@nonoun-plugins": true,
    "docs@nonoun-plugins": true,
    "teamwork@nonoun-plugins": true,
    "screens@nonoun-plugins": true,
    "agent-protocols@nonoun-plugins": true,
    "design@nonoun-plugins": true,
    "figma@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": true
  }
}
