  "genui": {
    "surfaceId": "fixture-anatomy-data-viz",
    "html": "<!doctype html><html><head><style>body{margin:0;padding:1rem;font-family:system-ui,sans-serif;color:var(--md-sys-color-neutral-on-surface,#1a1a1a);background:var(--md-sys-color-neutral-surface,#fff);}.chart{display:flex;align-items:flex-end;gap:0.85rem;height:7.5rem;}.bar{flex:1;display:flex;flex-direction:column;align-items:center;gap:0.35rem;height:100%;justify-content:flex-end;}.bar-fill{width:100%;border-radius:6px 6px 0 0;background:var(--md-sys-color-primary,#4a67ff);animation:grow 0.7s ease-out;transform-origin:bottom;}@keyframes grow{from{transform:scaleY(0);}to{transform:scaleY(1);}}.kpi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem;margin-top:1.25rem;}.kpi-card{padding:0.75rem;border-radius:8px;background:var(--md-sys-color-neutral-surface-high,#f2f2f2);border:1px solid var(--md-sys-color-neutral-outline-variant,#ddd);}.kpi-label{font-size:0.7rem;color:var(--md-sys-color-neutral-on-surface-variant,#666);}.kpi-value{font-size:1.4rem;font-weight:600;}</style></head><body><h2>Revenue by region</h2><div class=\"chart\" role=\"img\" aria-label=\"Revenue by region, bar comparison\"><div class=\"bar\"><div class=\"bar-fill\" style=\"height:78%\"></div><span>NA $182k</span></div><div class=\"bar\"><div class=\"bar-fill\" style=\"height:52%\"></div><span>EU $121k</span></div><div class=\"bar\"><div class=\"bar-fill\" style=\"height:34%\"></div><span>APAC $79k</span></div></div><div class=\"kpi-grid\"><div class=\"kpi-card\"><div class=\"kpi-label\">Top region</div><div class=\"kpi-value\">NA</div></div><div class=\"kpi-card\"><div class=\"kpi-label\">Total</div><div class=\"kpi-value\">$382k</div></div><div class=\"kpi-card\"><div class=\"kpi-label\">Regions</div><div class=\"kpi-value\">3</div></div></div></body></html>"
  }
