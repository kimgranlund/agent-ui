{"name":"interactive-widgets--interactive-widgets-3--run:2026-08-23T18:21:33.883Z-af2x2","promptId":"interactive-widgets-3","promptText":"Set up a simple two-player turn-based grid game they can play against each other while they wait for a match.","packId":"interactive-widgets","surfaceId":"tic-tac-toe-1","html":"<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><style>\n:root{color-scheme: light dark;}\nhtml,body{margin:0;padding:0;height:100%;}\nbody{\n  font-family: system-ui, sans-serif;\n  background: var(--md-sys-color-neutral-surface, #f5f5f5);\n  color: var(--md-sys-color-on-surface, #1a1a1a);\n  display:flex; flex-direction:column; align-items:center; justify-content:center;\n  min-height:100vh; gap:16px; box-sizing:border-box; padding:24px;\n}\nh1{font-size:1.1rem; margin:0; font-weight:600;}\n#status{font-size:0.95rem; opacity:0.85; min-height:1.2em;}\n#board{\n  display:grid; grid-template-columns: repeat(3, 84px); grid-template-rows: repeat(3, 84px);\n  gap:8px; background: var(--md-sys-color-outline-variant, #ccc); padding:8px; border-radius:12px;\n}\n.cell{\n  width:84px; height:84px; font-size:2.2rem; font-weight:700;\n  background: var(--md-sys-color-surface-container, #fff);\n  color: var(--md-sys-color-primary, #3355dd);\n  border: none; border-radius:8px; cursor:pointer;\n  display:flex; align-items:center; justify-content:center;\n  transition: transform 0.08s ease;\n}\n.cell:hover:not(:disabled){ transform: scale(1.04); }\n.cell:disabled{ cursor:default; }\n.cell[data-mark=\"O\"]{ color: var(--md-sys-color-tertiary, #cc4488); }\n.cell.win{ background: var(--md-sys-color-primary-container, #d6e0ff); }\n#reset{\n  margin-top:4px; padding:8px 18px; border-radius:20px; border:none;\n  background: var(--md-sys-color-secondary-container, #e0e0f0);\n  color: var(--md-sys-color-on-secondary-container, #1a1a1a);\n  font-size:0.9rem; cursor:pointer;\n}\n#reset:hover{ filter: brightness(1.05); }\n</style></head>\n<body>\n<h1>Tic-Tac-Toe — pass and play</h1>\n<div id=\"status\">Player X's turn</div>\n<div id=\"board\" role=\"grid\" aria-label=\"Tic-tac-toe board\"></div>\n<button id=\"reset\" aria-label=\"Reset the board\">Reset board</button>\n<script>\nvar board = Array(9).fill(null);\nvar current = 'X';\nvar over = false;\nvar boardEl = document.getElementById('board');\nvar statusEl = document.getElementById('status');\nvar lines = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];\n\nfunction checkWinner(){\n  for (var i=0;i<lines.length;i++){\n    var l = lines[i];\n    if (board[l[0]] && board[l[0]]===board[l[1]] && board[l[1]]===board[l[2]]) {\n      return { mark: board[l[0]], line: l };\n    }\n  }\n  if (board.every(function(c){ return c; })) return { mark: null, line: null, draw: true };\n  return null;\n}\n\nfunction render(){\n  boardEl.innerHTML = '';\n  for (var i=0;i<9;i++){\n    (function(idx){\n      var b = document.createElement('button');\n      b.type = 'button';\n      b.className = 'cell';\n      var row = Math.floor(idx/3)+1, col = (idx%3)+1;\n      b.setAttribute('aria-label', 'Cell row '+row+' column '+col+(board[idx] ? ', ' + board[idx] : ', empty'));\n      if (board[idx]) { b.textContent = board[idx]; b.setAttribute('data-mark', board[idx]); }\n      if (board[idx] || over) b.disabled = true;\n      b.addEventListener('click', function(){ playCell(idx); });\n      boardEl.appendChild(b);\n    })(i);\n  }\n}\n\nfunction playCell(idx){\n  if (over || board[idx]) return;\n  board[idx] = current;\n  var result = checkWinner();\n  render();\n  if (result && result.mark) {\n    over = true;\n    statusEl.textContent = 'Player ' + result.mark + ' wins!';\n    var cells = boardEl.children;\n    result.line.forEach(function(i){ cells[i].classList.add('win'); });\n    try { window.genui.action('game_over', { winner: result.mark }); } catch(e){}\n  } else if (result && result.draw) {\n    over = true;\n    statusEl.textContent = \"It's a draw!\";\n    try { window.genui.action('game_over', { winner: null }); } catch(e){}\n  } else {\n    current = current === 'X' ? 'O' : 'X';\n    statusEl.textContent = \"Player \" + current + \"'s turn\";\n  }\n}\n\ndocument.getElementById('reset').addEventListener('click', function(){\n  board = Array(9).fill(null);\n  current = 'X';\n  over = false;\n  statusEl.textContent = \"Player X's turn\";\n  render();\n  try { window.genui.action('reset', {}); } catch(e){}\n});\n\nrender();\n</script>\n</body></html>","meta":{"facet":"eval","status":"judged","promptSetVersion":1,"packHash":"86f7119fc2eeb505aecc9bb1f245ae72a1b679448663498dda8be9562ad373d1","htmlHash":"a7511541d01214a79b10d9c9379775179dd4b143c90faf3d993093d342b89fa5","model":"claude-sonnet-5","dogfood":false,"generatedAt":"2026-08-23T18:21:33.883Z","provenance":{"source":"generated","origin":"run:run:2026-08-23T18:21:33.883Z-af2x2"},"lint":{"byteLength":4094,"externalRefs":0,"tokenRefs":9,"scriptBlocks":1,"hasDoctype":true},"qualityScore":3,"passed":false,"failingDimensions":["D2"],"verdictDate":"2026-08-23T18:29:46.943Z"}}
