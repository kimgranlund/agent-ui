{"name":"control--animated-explainers-1--run:2026-08-23T18:17:07.642Z-k954w","promptId":"animated-explainers-1","promptText":"Walk new hires through the stages a support ticket moves through from open to resolved, and make clear which stage a given ticket is in right now.","packId":null,"surfaceId":"ticket-lifecycle-tour","html":"<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><style>\n:root{color-scheme: light dark;}\n*{box-sizing:border-box;}\nbody{margin:0;padding:24px;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--md-sys-color-surface,#fff);color:var(--md-sys-color-on-surface,#1a1a1a);}\nh1{font-size:1.1rem;font-weight:600;margin:0 0 4px 0;}\np.sub{margin:0 0 24px 0;color:var(--md-sys-color-on-surface-variant,#5f5f5f);font-size:0.85rem;}\n.timeline{display:flex;flex-wrap:wrap;gap:0;align-items:stretch;}\n.stage{flex:1 1 140px;min-width:120px;position:relative;padding:16px 12px;border-radius:12px;border:2px solid var(--md-sys-color-outline-variant,#d9d9d9);background:var(--md-sys-color-surface-container,#f5f5f5);cursor:pointer;transition:all .18s ease;margin:6px;text-align:center;}\n.stage:hover{border-color:var(--md-sys-color-primary,#6750a4);transform:translateY(-2px);}\n.stage .num{width:26px;height:26px;border-radius:50%;background:var(--md-sys-color-outline-variant,#d9d9d9);color:var(--md-sys-color-on-surface,#1a1a1a);display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:700;margin:0 auto 8px auto;}\n.stage .label{font-weight:600;font-size:0.9rem;margin-bottom:4px;}\n.stage .desc{font-size:0.72rem;color:var(--md-sys-color-on-surface-variant,#5f5f5f);line-height:1.3;}\n.stage.current{border-color:var(--md-sys-color-primary,#6750a4);background:var(--md-sys-color-primary-container,#eaddff);box-shadow:0 0 0 3px color-mix(in srgb, var(--md-sys-color-primary,#6750a4) 25%, transparent);}\n.stage.current .num{background:var(--md-sys-color-primary,#6750a4);color:var(--md-sys-color-on-primary,#fff);}\n.badge{display:none;position:absolute;top:-10px;right:-6px;background:var(--md-sys-color-primary,#6750a4);color:var(--md-sys-color-on-primary,#fff);font-size:0.62rem;font-weight:700;padding:3px 8px;border-radius:999px;letter-spacing:.03em;}\n.stage.current .badge{display:block;}\nfooter{margin-top:20px;font-size:0.78rem;color:var(--md-sys-color-on-surface-variant,#5f5f5f);}\n.arrow{display:flex;align-items:center;color:var(--md-sys-color-outline,#8a8a8a);font-size:1.2rem;padding:0 2px;}\n@media (max-width:700px){.arrow{display:none;}}\n</style></head><body>\n<h1>Support ticket lifecycle</h1>\n<p class=\"sub\">Click a stage to move the \"current\" marker and see when it applies. Ticket <strong>#4821</strong> is used as the running example below.</p>\n<div class=\"timeline\" id=\"tl\"></div>\n<footer id=\"foot\">Ticket #4821 is currently in <strong id=\"footStage\">In Progress</strong>.</footer>\n<script>\nconst stages = [\n {id:'open', label:'Open', desc:'Ticket just submitted. Not yet picked up by an agent.'},\n {id:'in_progress', label:'In Progress', desc:'An agent is actively investigating or working the issue.'},\n {id:'waiting', label:'Waiting on Customer', desc:'Blocked pending more info or confirmation from the requester.'},\n {id:'resolved', label:'Resolved', desc:'A fix or answer was applied; awaiting requester confirmation.'},\n {id:'closed', label:'Closed', desc:'Confirmed resolved (or timed out) — the ticket is fully done.'}\n];\nlet current = 'in_progress';\nconst tl = document.getElementById('tl');\nfunction render(){\n tl.innerHTML='';\n stages.forEach((s,i)=>{\n  const el=document.createElement('div');\n  el.className='stage'+(s.id===current?' current':'');\n  el.innerHTML='<div class=\"badge\">CURRENT</div><div class=\"num\">'+(i+1)+'</div><div class=\"label\">'+s.label+'</div><div class=\"desc\">'+s.desc+'</div>';\n  el.addEventListener('click',()=>{ current=s.id; render(); try{ genui.action('stage_selected',{stage:s.id, label:s.label}); }catch(e){} });\n  tl.appendChild(el);\n  if(i<stages.length-1){\n   const arrow=document.createElement('div');\n   arrow.className='arrow';\n   arrow.textContent='→';\n   tl.appendChild(arrow);\n  }\n });\n document.getElementById('footStage').textContent = stages.find(s=>s.id===current).label;\n}\nrender();\n</script>\n</body></html>","meta":{"facet":"eval","status":"judged","promptSetVersion":1,"packHash":null,"htmlHash":"2f27753b8fdc821af268d73122864763b14dbbc6aff07f3ea43e40a2a44fdae5","model":"claude-sonnet-5","dogfood":false,"generatedAt":"2026-08-23T18:17:07.643Z","provenance":{"source":"generated","origin":"run:run:2026-08-23T18:17:07.642Z-k954w"},"lint":{"byteLength":3991,"externalRefs":0,"tokenRefs":18,"scriptBlocks":1,"hasDoctype":true},"qualityScore":2,"passed":false,"failingDimensions":["D2"],"verdictDate":"2026-08-23T18:29:46.943Z"}}
{"name":"control--animated-explainers-3--run:2026-08-23T18:17:30.022Z-socw7","promptId":"animated-explainers-3","promptText":"Explain how an order moves from cart to payment to confirmation, and show that we're currently sitting at the payment step.","packId":null,"surfaceId":"order-flow-tracker","html":"<!DOCTYPE html><html><head><meta charset=\"utf-8\"><style>\n  :root { color-scheme: light dark; }\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    padding: 32px 24px;\n    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\n    background: var(--md-sys-color-neutral-surface, #fafafa);\n    color: var(--md-sys-color-on-surface, #1a1a1a);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 28px;\n  }\n  h1 {\n    font-size: 18px;\n    font-weight: 600;\n    margin: 0;\n    text-align: center;\n  }\n  .tracker {\n    display: flex;\n    align-items: flex-start;\n    width: 100%;\n    max-width: 560px;\n  }\n  .step {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    position: relative;\n    text-align: center;\n  }\n  .circle {\n    width: 44px;\n    height: 44px;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: 700;\n    font-size: 15px;\n    border: 2px solid var(--md-sys-color-outline, #999);\n    background: var(--md-sys-color-surface-container, #eee);\n    color: var(--md-sys-color-on-surface-variant, #555);\n    z-index: 2;\n    transition: all 0.3s ease;\n  }\n  .step.done .circle {\n    background: var(--md-sys-color-primary, #4f46e5);\n    border-color: var(--md-sys-color-primary, #4f46e5);\n    color: var(--md-sys-color-on-primary, #fff);\n  }\n  .step.current .circle {\n    background: var(--md-sys-color-primary-container, #dfe3ff);\n    border-color: var(--md-sys-color-primary, #4f46e5);\n    color: var(--md-sys-color-primary, #4f46e5);\n    box-shadow: 0 0 0 6px var(--md-sys-color-primary-container, #e8eaff);\n    animation: pulse 1.8s ease-in-out infinite;\n  }\n  @keyframes pulse {\n    0%, 100% { box-shadow: 0 0 0 6px var(--md-sys-color-primary-container, #e8eaff); }\n    50% { box-shadow: 0 0 0 10px var(--md-sys-color-primary-container, #e8eaff); }\n  }\n  .label {\n    margin-top: 10px;\n    font-size: 13px;\n    font-weight: 600;\n    color: var(--md-sys-color-on-surface, #1a1a1a);\n  }\n  .sublabel {\n    margin-top: 2px;\n    font-size: 11px;\n    color: var(--md-sys-color-on-surface-variant, #777);\n    max-width: 120px;\n  }\n  .connector {\n    position: absolute;\n    top: 22px;\n    left: 50%;\n    width: 100%;\n    height: 2px;\n    background: var(--md-sys-color-outline-variant, #ccc);\n    z-index: 1;\n  }\n  .step.done .connector {\n    background: var(--md-sys-color-primary, #4f46e5);\n  }\n  .step:last-child .connector { display: none; }\n  .badge {\n    margin-top: 14px;\n    padding: 6px 14px;\n    border-radius: 999px;\n    background: var(--md-sys-color-primary-container, #dfe3ff);\n    color: var(--md-sys-color-primary, #4f46e5);\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 0.02em;\n  }\n</style></head>\n<body>\n  <h1>Order progress</h1>\n  <div class=\"tracker\">\n    <div class=\"step done\">\n      <div class=\"connector\"></div>\n      <div class=\"circle\">✓</div>\n      <div class=\"label\">Cart</div>\n      <div class=\"sublabel\">Items reviewed & confirmed</div>\n    </div>\n    <div class=\"step current\">\n      <div class=\"connector\"></div>\n      <div class=\"circle\">2</div>\n      <div class=\"label\">Payment</div>\n      <div class=\"sublabel\">Entering payment details now</div>\n    </div>\n    <div class=\"step\">\n      <div class=\"circle\">3</div>\n      <div class=\"label\">Confirmation</div>\n      <div class=\"sublabel\">Order receipt & summary</div>\n    </div>\n  </div>\n  <div class=\"badge\">You are here: Payment</div>\n</body></html>","meta":{"facet":"eval","status":"judged","promptSetVersion":1,"packHash":null,"htmlHash":"d21ea7c3f4da311bbfff7d5b59c68fdcc28622810483f7cf75f811f78e9efa18","model":"claude-sonnet-5","dogfood":false,"generatedAt":"2026-08-23T18:17:30.022Z","provenance":{"source":"generated","origin":"run:run:2026-08-23T18:17:30.022Z-socw7"},"lint":{"byteLength":3507,"externalRefs":0,"tokenRefs":20,"scriptBlocks":0,"hasDoctype":true},"qualityScore":4,"passed":true,"verdictDate":"2026-08-23T18:29:46.943Z"}}
{"name":"control--data-viz-layouts-2--run:2026-08-23T18:17:53.176Z-5c49i","promptId":"data-viz-layouts-2","promptText":"Give me a quick snapshot of active users, churn rate, and average session length for this week.","packId":null,"surfaceId":"weekly-snapshot","html":"<!DOCTYPE html><html><head><meta charset=\"utf-8\"><style>\n:root{color-scheme: light dark;}\nbody{margin:0;padding:24px;font-family:system-ui,-apple-system,'Segoe UI',sans-serif;background:var(--md-sys-color-neutral-surface,#f5f5f7);color:var(--md-sys-color-neutral-on-surface,#1a1a1a);}\nh1{font-size:18px;font-weight:600;margin:0 0 4px 0;}\np.sub{margin:0 0 20px 0;font-size:13px;color:var(--md-sys-color-neutral-outline,#666);}\n.grid{display:flex;gap:16px;flex-wrap:wrap;}\n.tile{flex:1 1 180px;background:var(--md-sys-color-neutral-surface-container,#fff);border:1px solid var(--md-sys-color-neutral-outline-variant,#e0e0e0);border-radius:12px;padding:18px;box-shadow:0 1px 2px rgba(0,0,0,0.06);}\n.label{font-size:12px;text-transform:uppercase;letter-spacing:0.06em;color:var(--md-sys-color-neutral-outline,#777);margin-bottom:8px;}\n.value{font-size:28px;font-weight:700;color:var(--md-sys-color-primary,#3a5ba0);}\n.note{font-size:12px;color:var(--md-sys-color-neutral-outline,#888);margin-top:6px;}\n.footer{margin-top:20px;font-size:12px;color:var(--md-sys-color-neutral-outline,#888);}\n</style></head><body>\n<h1>Weekly snapshot</h1>\n<p class=\"sub\">This week · placeholders — no analytics source connected yet</p>\n<div class=\"grid\">\n  <div class=\"tile\"><div class=\"label\">Active users</div><div class=\"value\">—</div><div class=\"note\">Awaiting data feed</div></div>\n  <div class=\"tile\"><div class=\"label\">Churn rate</div><div class=\"value\">—</div><div class=\"note\">Awaiting data feed</div></div>\n  <div class=\"tile\"><div class=\"label\">Avg. session length</div><div class=\"value\">—</div><div class=\"note\">Awaiting data feed</div></div>\n</div>\n<div class=\"footer\">Tell me where this data lives (a table, an API, pasted numbers) and I'll fill this in.</div>\n</body></html>","meta":{"facet":"eval","status":"judged","promptSetVersion":1,"packHash":null,"htmlHash":"2d44491691a37f3c5f936926df0e5c7ba5a1ac813fb0fa5ea42a86e75af0037e","model":"claude-sonnet-5","dogfood":false,"generatedAt":"2026-08-23T18:17:53.176Z","provenance":{"source":"generated","origin":"run:run:2026-08-23T18:17:53.176Z-5c49i"},"lint":{"byteLength":1776,"externalRefs":0,"tokenRefs":9,"scriptBlocks":0,"hasDoctype":true},"qualityScore":2,"passed":false,"failingDimensions":["D2","D3"],"verdictDate":"2026-08-23T18:29:46.943Z"}}
{"name":"control--interactive-widgets-1--run:2026-08-23T18:18:16.644Z-qgv8h","promptId":"interactive-widgets-1","promptText":"Let the reviewer rate this design submission out of five stars.","packId":null,"surfaceId":"design-review-rating","html":"<!DOCTYPE html><html><head><meta charset=\"utf-8\"><style>:root{color-scheme:light dark;}body{margin:0;padding:24px;font-family:system-ui,sans-serif;background:var(--md-sys-color-neutral-surface,#fff);color:var(--md-sys-color-neutral-on-surface,#1a1a1a);display:flex;flex-direction:column;align-items:center;gap:16px;}h1{font-size:18px;font-weight:600;margin:0;text-align:center;}.stars{display:flex;gap:6px;}button.star{background:none;border:none;cursor:pointer;padding:4px;font-size:40px;line-height:1;color:var(--md-sys-color-neutral-outline,#bbb);transition:color .15s,transform .1s;}button.star:hover{transform:scale(1.15);}button.star.filled{color:var(--md-sys-color-primary-primary,#f5a623);}.label{font-size:14px;min-height:20px;color:var(--md-sys-color-neutral-on-surface-variant,#666);}button.submit{margin-top:8px;padding:10px 24px;border-radius:8px;border:none;background:var(--md-sys-color-primary-primary,#4a63e7);color:var(--md-sys-color-primary-on-primary,#fff);font-size:14px;font-weight:600;cursor:pointer;opacity:0.4;pointer-events:none;transition:opacity .15s;}button.submit.active{opacity:1;pointer-events:auto;}</style></head><body><h1>Rate this design submission</h1><div class=\"stars\" id=\"stars\"></div><div class=\"label\" id=\"label\">Tap a star to rate</div><button class=\"submit\" id=\"submitBtn\">Submit rating</button><script>const labels=['Poor','Fair','Good','Very good','Excellent'];let rating=0;const starsEl=document.getElementById('stars');const labelEl=document.getElementById('label');const submitBtn=document.getElementById('submitBtn');for(let i=1;i<=5;i++){const b=document.createElement('button');b.className='star';b.textContent='★';b.dataset.value=i;b.addEventListener('click',()=>setRating(i));b.addEventListener('mouseenter',()=>preview(i));b.addEventListener('mouseleave',()=>preview(rating));starsEl.appendChild(b);}function preview(n){[...starsEl.children].forEach((el,idx)=>{el.classList.toggle('filled',idx<n);});labelEl.textContent=n>0?labels[n-1]:'Tap a star to rate';}function setRating(n){rating=n;preview(n);submitBtn.classList.toggle('active',rating>0);}submitBtn.addEventListener('click',()=>{if(rating>0){genui.action('submit_rating',{rating:rating});labelEl.textContent='Thanks! You rated '+rating+' star'+(rating>1?'s':'');}});</script></body></html>","meta":{"facet":"eval","status":"judged","promptSetVersion":1,"packHash":null,"htmlHash":"15da2363733114d5c7ac5e6d44f4c81622738bb2a206cacf57e96f432bf914ce","model":"claude-sonnet-5","dogfood":false,"generatedAt":"2026-08-23T18:18:16.644Z","provenance":{"source":"generated","origin":"run:run:2026-08-23T18:18:16.644Z-qgv8h"},"lint":{"byteLength":2304,"externalRefs":0,"tokenRefs":7,"scriptBlocks":1,"hasDoctype":true},"qualityScore":4,"passed":true,"verdictDate":"2026-08-23T18:29:46.943Z"}}
{"name":"control--interactive-widgets-2--run:2026-08-23T18:18:30.863Z-huw0w","promptId":"interactive-widgets-2","promptText":"Give the user three delivery-time options to choose from, and let them see which one they picked.","packId":null,"surfaceId":"delivery-time-picker","html":"<!DOCTYPE html><html><head><meta charset=\"utf-8\"><style>\n:root{color-scheme: light dark;}\nbody{margin:0;padding:20px;font-family:system-ui,-apple-system,sans-serif;background:var(--md-sys-color-neutral-surface,#fff);color:var(--md-sys-color-neutral-on-surface,#1a1a1a);}\nh2{margin:0 0 4px 0;font-size:1.1rem;font-weight:600;}\np.sub{margin:0 0 18px 0;font-size:0.85rem;opacity:0.7;}\n.options{display:flex;flex-direction:column;gap:10px;}\n.option{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-radius:12px;border:2px solid var(--md-sys-color-neutral-outline,#ccc);background:var(--md-sys-color-neutral-surface-container,#f5f5f5);cursor:pointer;transition:all 0.15s ease;}\n.option:hover{border-color:var(--md-sys-color-primary,#4a6cf7);}\n.option.selected{border-color:var(--md-sys-color-primary,#4a6cf7);background:var(--md-sys-color-primary-container,#e8edff);}\n.option .label{font-weight:600;font-size:0.95rem;}\n.option .desc{font-size:0.8rem;opacity:0.7;margin-top:2px;}\n.option .price{font-size:0.9rem;font-weight:600;opacity:0.85;}\n.check{width:20px;height:20px;border-radius:50%;border:2px solid var(--md-sys-color-neutral-outline,#aaa);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-right:12px;}\n.option.selected .check{border-color:var(--md-sys-color-primary,#4a6cf7);background:var(--md-sys-color-primary,#4a6cf7);}\n.check::after{content:'';width:8px;height:8px;border-radius:50%;background:#fff;opacity:0;}\n.option.selected .check::after{opacity:1;}\n.row{display:flex;align-items:center;}\n.status{margin-top:16px;font-size:0.85rem;padding:10px 14px;border-radius:10px;background:var(--md-sys-color-secondary-container,#eef1f7);opacity:0;transition:opacity 0.2s;}\n.status.show{opacity:1;}\n</style></head><body>\n<h2>Choose delivery time</h2>\n<p class=\"sub\">Pick the option that works best for you</p>\n<div class=\"options\" id=\"opts\">\n <div class=\"option\" data-id=\"standard\" data-label=\"Standard (3-5 days)\">\n   <div class=\"row\"><div class=\"check\"></div><div><div class=\"label\">Standard</div><div class=\"desc\">Arrives in 3–5 business days</div></div></div>\n   <div class=\"price\">Free</div>\n </div>\n <div class=\"option\" data-id=\"express\" data-label=\"Express (1-2 days)\">\n   <div class=\"row\"><div class=\"check\"></div><div><div class=\"label\">Express</div><div class=\"desc\">Arrives in 1–2 business days</div></div></div>\n   <div class=\"price\">$8.99</div>\n </div>\n <div class=\"option\" data-id=\"overnight\" data-label=\"Overnight (next day)\">\n   <div class=\"row\"><div class=\"check\"></div><div><div class=\"label\">Overnight</div><div class=\"desc\">Arrives next business day</div></div></div>\n   <div class=\"price\">$19.99</div>\n </div>\n</div>\n<div class=\"status\" id=\"status\"></div>\n<script>\nconst opts = document.querySelectorAll('.option');\nconst status = document.getElementById('status');\nopts.forEach(o => {\n  o.addEventListener('click', () => {\n    opts.forEach(x => x.classList.remove('selected'));\n    o.classList.add('selected');\n    status.textContent = 'Selected: ' + o.dataset.label;\n    status.classList.add('show');\n    if (window.genui && genui.action) {\n      genui.action('select_delivery_time', {id: o.dataset.id, label: o.dataset.label});\n    }\n  });\n});\n</script>\n</body></html>","meta":{"facet":"eval","status":"judged","promptSetVersion":1,"packHash":null,"htmlHash":"4a8712bbb2753f7fd15a0cada883eecd3355b72996873adadab9055cc8c759fd","model":"claude-sonnet-5","dogfood":false,"generatedAt":"2026-08-23T18:18:30.863Z","provenance":{"source":"generated","origin":"run:run:2026-08-23T18:18:30.863Z-huw0w"},"lint":{"byteLength":3