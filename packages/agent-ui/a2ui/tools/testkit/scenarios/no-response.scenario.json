{
  "kind": "agent-ui-a2ui-scenario",
  "version": 1,
  "name": "no-response",
  "description": "An action declared wantResponse: false is emitted but runs no agent turn.",
  "catalogId": "agent-ui",
  "intent": "show a dismissible notice",
  "turns": [
    {
      "respond": {
        "lines": [
          {
            "version": "v1.0",
            "createSurface": {
              "surfaceId": "notice",
              "catalogId": "agent-ui"
            }
          },
          {
            "version": "v1.0",
            "updateComponents": {
              "surfaceId": "notice",
              "components": [
                {
                  "id": "root",
                  "component": "Column",
                  "children": [
                    "msg",
                    "ok"
                  ]
                },
                {
                  "id": "msg",
                  "component": "Text",
                  "text": "Saved."
                },
                {
                  "id": "ok",
                  "component": "Button",
                  "label": "Dismiss",
                  "action": {
                    "action": "dismiss",
                    "wantResponse": false
                  }
                }
              ]
            }
          }
        ]
      },
      "expect": {
        "clientMessages": [
          {
            "action": {
              "name": "dismiss",
              "wantResponse": false
            }
          }
        ]
      },
      "act": {
        "click": {
          "surfaceId": "notice",
          "select": "ui-button"
        }
      }
    }
  ]
}
