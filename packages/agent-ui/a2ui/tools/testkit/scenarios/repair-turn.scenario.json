{
  "kind": "agent-ui-a2ui-scenario",
  "version": 1,
  "name": "repair-turn",
  "description": "The first round names an unknown type; the producer feeds the CATALOG failure back and the second round validates.",
  "catalogId": "agent-ui",
  "intent": "what is the weather",
  "turns": [
    {
      "respond": {
        "rounds": [
          "{\"version\":\"v1.0\",\"updateComponents\":{\"surfaceId\":\"weather\",\"components\":[{\"id\":\"root\",\"component\":\"NoSuchType\"}]}}",
          "{\"a2uiMeta\":{\"note\":\"Here is the forecast.\"}}\n{\"version\":\"v1.0\",\"createSurface\":{\"surfaceId\":\"weather\",\"catalogId\":\"agent-ui\"}}\n{\"version\":\"v1.0\",\"updateComponents\":{\"surfaceId\":\"weather\",\"components\":[{\"id\":\"root\",\"component\":\"Text\",\"text\":\"Sunny, 21 C\"}]}}"
        ]
      },
      "expect": {
        "produce": {
          "outcome": "eventual",
          "rounds": 2,
          "failureCodes": [
            "CATALOG"
          ]
        },
        "tree": [
          {
            "surfaceId": "weather",
            "select": "ui-text",
            "textIncludes": "Sunny"
          }
        ]
      }
    }
  ]
}
