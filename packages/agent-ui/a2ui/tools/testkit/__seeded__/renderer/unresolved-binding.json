  "catalogId": "agent-ui",
  "intent": "greet the user",
  "expectRed": {
    "layer": "renderer",
    "code": "BINDING_UNRESOLVED"
  },
  "turns": [
    {
      "respond": {
        "lines": [
          {
            "version": "v1.0",
            "createSurface": {
              "surfaceId": "s",
              "catalogId": "agent-ui"
            }
          },
          {
            "version": "v1.0",
            "updateComponents": {
              "surfaceId": "s",
              "components": [
                {
                  "id": "root",
                  "component": "Text",
                  "text": {
                    "path": "/user/name"
                  }
                }
              ]
            }
          },
          {
            "version": "v1.0",
            "updateDataModel": {
              "surfaceId": "s",
              "value": {
                "user": {}
              }
            }
          }
        ]
      },
      "expect": {
        "bindings": {}
      }
    }
  ]
}
