{
  "components": {
    "BookingForm": {
      "properties": {
        "title": { "type": { "type": "string" }, "bindable": true, "mapsTo": "title" },
        "fields": {
          "type": {
            "type": "array",
            "description": "One item per field, its value written at path. dateSingle: one date. dateRange: a stay, start date at path and end date at endPath (endLabel names it). select: one of many options. radio: one of two to five options, shown side by side. checkbox: a Yes or No answer. text: free text. number: a number typed in. time: a time of day. stepper: a count such as a party size, from min to max by step.",
            "items": {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "enum": ["dateSingle", "dateRange", "select", "radio", "checkbox", "text", "number", "time", "stepper"] },
                "path": { "type": "string" },
                "endPath": { "type": "string" },
                "label": { "type": "string" },
                "endLabel": { "type": "string" },
                "required": { "type": "boolean" },
                "min": { "type": "number" },
                "max": { "type": "number" },
                "step": { "type": "number" },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": { "value": { "type": "string" }, "label": { "type": "string" } },
                    "required": ["value", "label"]
                  }
                }
              },
              "required": ["kind", "path", "label"]
            }
          },
          "mapsTo": "fields"
        },
        "value": { "type": { "type": "object" }, "bindable": true, "mapsTo": "value" }
      },
      "children": "child",
      "value": { "prop": "value", "event": "change", "readProp": "a2uiFormValue" }
    },
    "BookingConfirmation": {
      "properties": {
        "title": { "type": { "type": "string" }, "bindable": true, "mapsTo": "title" },
        "rows": {
          "type": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "path": { "type": "string" },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": { "value": { "type": "string" }, "label": { "type": "string" } },
                    "required": ["value", "label"]
                  }
                }
              },
              "required": ["label", "path"]
            }
          },
          "mapsTo": "rows"
        },
        "data": { "type": { "type": "object" }, "bindable": true, "mapsTo": "data" }
      }
    }
  },
  "functions": {}
}
