{
  "components": {
    "QuestionCard": {
      "properties": {
        "label": { "type": { "type": "string" }, "bindable": true, "mapsTo": "label" },
        "meta": { "type": { "type": "string" }, "bindable": true, "mapsTo": "meta" },
        "question": { "type": { "type": "string" }, "bindable": true, "mapsTo": "question" },
        "explanation": { "type": { "type": "string" }, "bindable": true, "mapsTo": "explanation" },
        "name": { "type": { "type": "string" }, "bindable": true, "mapsTo": "name" },
        "options": {
          "type": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "value": { "type": "string" }, "label": { "type": "string" } },
              "required": ["value", "label"]
            }
          },
          "bindable": true,
          "mapsTo": "options"
        },
        "value": { "type": { "type": "string" }, "bindable": true, "mapsTo": "value" },
        "answer": { "type": { "type": "string" }, "bindable": true, "mapsTo": "answer" },
        "revealed": { "type": { "type": "boolean" }, "bindable": true, "mapsTo": "revealed" },
        "progress": {
          "type": {
            "type": "object",
            "properties": { "value": { "type": "number" }, "max": { "type": "number" } }
          },
          "bindable": true,
          "mapsTo": "progress"
        }
      },
      "children": "ChildList",
      "value": { "prop": "value", "event": "change", "readProp": "a2uiQuestionValue" }
    }
  },
  "functions": {}
}
