{
	// The docs site's Workers deploy target (Cloudflare now steers static-site deploys to Workers +
	// Static Assets rather than Pages — see the Pages→Workers migration guide). A DISTINCT Worker from
	// `agent-ui-site` (that name is a red herring — it's the live nonoun product app, not this docs
	// site). Custom domain: ui.nonoun.io.
	//
	// `main` + `assets.binding` (rather than assets-only): the docs site itself is still zero server
	// logic, but the Worker also serves the production live-agent proxy under `/__a2ui/agent` (the
	// Cloudflare port of `packages/agent-ui/a2ui/tools/agent/dev-proxy-plugin.ts`, superseding SPEC-R3/N2's
	// "static site ships the recorded backbone alone" — see worker/index.ts's header). `env.ASSETS.fetch()`
	// is the explicit fallback for any request `main` doesn't own; Cloudflare still serves a matched static
	// file directly without invoking the Worker at all (default `run_worker_first: false`).
	"name": "agent-ui-docs",
	"compatibility_date": "2026-07-19",
	// T-0438: `enable_request_signal` makes an incoming request's `signal` fire when the client disconnects
	// (developers.cloudflare.com/workers/configuration/compatibility-flags/, "Enable Request.signal for
	// incoming requests"; the Request API page's `signal` property). The flag has NO default-on date, so no
	// `compatibility_date` bump turns it on: without it a visitor's Cancel never reaches the in-flight, paid
	// model call of `/__a2ui/agent` or `/__a2a/arena`. workerd notices the disconnect on the next body write,
	// so both streaming routes keep writing during a model call (deltas, the arena's blank-line heartbeat).
	// Proven against the real bundle in workerd by worker/request-signal.test.ts.
	"compatibility_flags": ["nodejs_compat", "enable_request_signal"],
	// GH #102 (review finding): omitting this defaults to `true`, which put the Custom Domain's zone-scoped
	// rate-limit rule on ui.nonoun.io behind a second, completely unthrottled front door at
	// agent-ui-docs.<account>.workers.dev — verified live (25/25 requests succeeded there with no limit).
	// Independent of Custom Domains (a separate routing mechanism); disabling this does not affect
	// ui.nonoun.io. Also disables Preview URLs as a side effect on Wrangler 4.44+ (another surface this
	// closes).
	"workers_dev": false,
	"main": "packages/agent-ui/a2ui/tools/agent/worker/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Lets the Worker bundle statically `import` the corpus JSONL shard (worker/index.ts) as plain text.
	"rules": [{ "type": "Text", "globs": ["**/*.jsonl"] }],
	// T-0430: the A2A arena's live match (`/__a2a/arena`, worker/arena-route.ts) starts at most one match per
	// visitor IP per minute (counted per Cloudflare location). The route FAILS CLOSED without this binding:
	// `/status` reports unavailable and POST answers 503. The ADR-0152 zone Rate Limiting Rule covers only
	// `/__a2ui/agent`, so until it is extended in the dashboard this binding is the arena's only throttle.
	"ratelimits": [{ "name": "ARENA_RATE_LIMITER", "namespace_id": "4300", "simple": { "limit": 1, "period": 60 } }]
}
