      "respond": {
        "lines": [
          "{\"version\":\"v1.0\",\"createSurface\":{\"surfaceId\":\"canvas\",\"catalogId\":\"agent-ui\"}}",
          "{\"version\":\"v1.0\",\"updateComponents\":{\"surfaceId\":\"canvas\",\"components\":[{\"id\":\"root\",\"component\":\"Column\",\"children\":[\"btn\"]},{\"id\":\"btn\",\"component\":\"Button\",\"variant\":\"solid\",\"label\":\"Click me\",\"action\":{\"action\":\"submit\"}}]}}",
          "{\"a2uiMeta\":{\"note\":\"Scripted surface: one button.\"}}"
        ]
      }
    }
  ]
}
